/**detail.wxss - 基金详情页面**/
page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding: 0 !important;
  justify-content: flex-start !important;
  align-items: stretch !important;
}

.loading {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #999;
}

.content {
  flex: 1;
  height: 100%;
  /* 预留固定底部"买入/卖出"操作栏的高度 + iPhone 底部安全区，
     否则滚动内容末尾的"删除持仓"按钮会被操作栏盖住、难以滑出 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 基金标题 */
.fund-title {
  background: white;
  padding: 30rpx;
  text-align: center;
  margin: 20rpx 20rpx 20rpx 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.fund-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-code {
  font-size: 26rpx;
  color: #999;
}

.fund-code-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.switch-share-class {
  font-size: 22rpx;
  color: white;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #7CB9E8 0%, #6BA8D8 100%);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(124, 185, 232, 0.3);
  transition: all 0.3s;
  white-space: nowrap;
  line-height: 1.2;
}

.switch-share-class:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(124, 185, 232, 0.4);
}

.delete-holding-pill {
  font-size: 22rpx;
  color: #ff4444;
  padding: 10rpx 24rpx;
  background: #fff;
  border: 1rpx solid #ff4444;
  border-radius: 30rpx;
  white-space: nowrap;
  line-height: 1.2;
  transition: all 0.3s;
}

.delete-holding-pill:active {
  transform: scale(0.95);
  background: #fff0f0;
}

/* 份额类别选择弹窗 */
.share-class-modal {
  width: 650rpx;
  max-height: 80vh;
}

.share-class-list {
  max-height: 500rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.share-class-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  margin-bottom: 15rpx;
  transition: all 0.3s;
  background: white;
}

.share-class-item:last-child {
  margin-bottom: 0;
}

.share-class-item:active {
  transform: scale(0.98);
}

.share-class-item.active {
  border-color: #7CB9E8;
  background: linear-gradient(135deg, #f0f8ff 0%, #e8f4ff 100%);
  box-shadow: 0 4rpx 12rpx rgba(124, 185, 232, 0.2);
}

.share-class-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.share-class-badge {
  font-size: 24rpx;
  color: #7CB9E8;
  background: #e8f4ff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

.share-class-item.active .share-class-badge {
  background: #7CB9E8;
  color: white;
}

.share-class-check {
  font-size: 32rpx;
  color: #7CB9E8;
  font-weight: bold;
}

.share-class-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* 份额类别弹窗的按钮样式 */
.share-class-modal .modal-btn.cancel {
  width: 100%;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  color: #666;
  font-weight: 500;
}

/* 数据网格 */
.data-grid {
  background: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin: 0 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.grid-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 50rpx;
}

.grid-row:last-child {
  margin-bottom: 0;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.grid-label {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.grid-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.positive {
  color: #f56c6c;
}

.negative {
  color: #67c23a;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  /* 底部额外预留 iPhone 安全区，避免按钮被 home 指示条遮挡 */
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.buy {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
}

.action-btn.sell {
  background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
  color: white;
}

/* 交易弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  width: 600rpx;
  max-width: 90vw;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #7CB9E8 0%, #6BA8D8 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(124, 185, 232, 0.3);
}

/* 删除按钮 */
.delete-section {
  padding: 0 20rpx;
  margin-top: 20rpx;
}

.delete-holding-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #ff4444 0%, #e63939 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 68, 68, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.delete-holding-btn::after {
  border: none;
}

/* 重仓股票 */
.section {
  background: white;
  padding: 0;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.section-header {
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
  padding: 25rpx 30rpx 20rpx 30rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-date {
  font-size: 22rpx;
  color: #999;
  background: white;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.stock-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  padding: 0 10rpx;
}

.header-name {
  flex: 2;
  text-align: left;
}

.header-ratio {
  flex: 1;
  text-align: center;
}

.header-change {
  flex: 1;
  text-align: right;
}

.stock-list {
  padding: 0 30rpx;
}

.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
  transition: background 0.2s;
}

.stock-item:last-child {
  border-bottom: none;
}

.stock-item:active {
  background: #f8f9fa;
}

.stock-left {
  flex: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.stock-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.stock-code {
  font-size: 22rpx;
  color: #999;
  font-family: 'Courier New', monospace;
}

.stock-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.stock-ratio {
  font-size: 28rpx;
  font-weight: 600;
  color: #7CB9E8;
  background: linear-gradient(135deg, #e8f4ff 0%, #f0f8ff 100%);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  line-height: 1.4;
}

.stock-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.stock-change {
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  min-width: 100rpx;
  text-align: center;
  display: inline-block;
  line-height: 1.4;
}

.stock-change.positive {
  color: #f56c6c;
  background: linear-gradient(135deg, #fff0f0 0%, #ffe8e8 100%);
}

.stock-change.negative {
  color: #67c23a;
  background: linear-gradient(135deg, #f0fff4 0%, #e8ffe8 100%);
}

.stock-change-loading {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx 16rpx;
  min-width: 100rpx;
  text-align: center;
  display: inline-block;
  line-height: 1.4;
}

/* 行业配置 */
.industry-list {
  margin-top: 20rpx;
}

.industry-item {
  margin-bottom: 25rpx;
}

.industry-item:last-child {
  margin-bottom: 0;
}

.industry-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.industry-name {
  font-size: 26rpx;
  color: #333;
}

.industry-ratio {
  font-size: 26rpx;
  font-weight: bold;
  color: #7CB9E8;
}

.industry-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.industry-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7CB9E8 0%, #6BA8D8 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 估值分时图（东财官方 PNG） */
.gsz-chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 24rpx 20rpx;
}
.gsz-chart-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.gsz-chart-img { width: 100%; display: block; border-radius: 8rpx; background: #fafafa; }
.gsz-chart-tip { font-size: 20rpx; color: #bbb; margin-top: 8rpx; }

/* 涨跌提醒入口 */
.alert-pill {
  display: inline-block;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #7CB9E8;
  border: 1rpx solid #7CB9E8;
  border-radius: 24rpx;
}

/* 阶段业绩 */
.perf-card, .info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx 20rpx;
}
.perf-title, .info-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.perf-sub { font-size: 22rpx; color: #999; font-weight: 400; margin-left: 8rpx; }
.perf-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 24rpx; }
.perf-label { width: 120rpx; color: #666; }
.perf-syl { flex: 1; text-align: right; font-weight: 600; }
.perf-rank { width: 160rpx; text-align: right; color: #999; }

/* 基本信息 */
.info-grid { display: flex; flex-wrap: wrap; }
.info-item { width: 50%; display: flex; flex-direction: column; padding: 10rpx 0; }
.info-k { font-size: 22rpx; color: #999; }
.info-v { font-size: 26rpx; color: #333; margin-top: 4rpx; }
.info-bench { font-size: 22rpx; color: #aaa; margin-top: 12rpx; line-height: 1.5; }
