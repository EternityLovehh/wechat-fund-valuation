/**holding.wxss - 持仓页面**/
page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding: 0 !important;
  justify-content: flex-start !important;
  align-items: stretch !important;
}

.summary {
  background: white;
  color: #333;
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  color: #333;
}

.summary-profit-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.summary-profit {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 1;
  letter-spacing: 0.5rpx;
}

.data-source-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 12rpx;
  margin: 4rpx 0 12rpx;
  font-size: 22rpx;
  color: #999;
}

.ds-status {
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  color: #666;
  font-weight: 500;
}
.ds-status.ds-trading {
  background: #ffeae0;
  color: #ff5722;
}
.ds-status.ds-lunch,
.ds-status.ds-pre-open,
.ds-status.ds-post-close {
  background: #eef4ff;
  color: #4a8cff;
}
.ds-status.ds-weekend {
  background: #f0f0f0;
  color: #999;
}

.ds-item {
  color: #888;
}
.ds-hint {
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 2rpx;
}

.summary-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.import-btn, .clear-btn, .calendar-btn {
  flex: 1;
  background: #7CB9E8;
  color: white;
  font-size: 26rpx;
  border: none;
  padding: 12rpx 24rpx;
  height: auto;
  line-height: 1.4;
  border-radius: 8rpx;
  font-weight: 500;
}

.calendar-btn {
  background: #9c88d4;
}

.clear-btn {
  background: #ff5722;
}

.loading, .empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
  background: white;
}

.empty-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 列表容器 */
.fund-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: white;
  overflow: hidden;
  min-height: 0;
}

.list-header {
  display: flex;
  height: 70rpx;
  align-items: center;
  background: #f8f8f8;
  padding: 0 24rpx;
  flex-shrink: 0;
  gap: 12rpx;
}

.header-name {
  flex: 4;
  font-size: 24rpx;
  color: #999;
}

.header-amount {
  flex: 2;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.header-profit {
  flex: 2;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.list-body {
  flex: 1;
  min-height: 0;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
  gap: 12rpx;
}

.list-item:active {
  background: #f8f9fa;
}

.list-item:last-child {
  border-bottom: none;
}

.item-name {
  flex: 4;
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 6rpx;
}

.fund-name {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-code {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fund-ratio {
  font-size: 22rpx;
  font-weight: 500;
  color: #7CB9E8;
  flex-shrink: 0;
}

.pending-tag {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #b26a00;
  background: #fff3e0;
  border-radius: 6rpx;
  vertical-align: middle;
}

.pending-text {
  color: #b26a00 !important;
  font-size: 22rpx;
}

.item-amount {
  flex: 2;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.amount-pending {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #b26a00;
}

.item-profit {
  flex: 2;
  text-align: right;
}

.profit-rate {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.profit-amount {
  font-size: 22rpx;
  font-weight: 500;
}

.positive {
  color: #f56c6c;
}

.negative {
  color: #67c23a;
}

/* 自算估值角标：区分"前十大重仓自算"的近似值与官方估值 */
.est-tag {
  font-size: 16rpx;
  color: #ff9800;
  border: 1rpx solid #ffcc80;
  background: #fff8ec;
  padding: 0 4rpx;
  border-radius: 4rpx;
  margin-left: 6rpx;
  line-height: 1.3;
  vertical-align: middle;
}

/* 持仓诊断卡片 */
.diagnosis {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.diag-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 18rpx; }
.diag-stats { display: flex; justify-content: space-around; margin-bottom: 20rpx; }
.diag-stat { display: flex; flex-direction: column; align-items: center; }
.ds-num { font-size: 34rpx; font-weight: 600; color: #7CB9E8; }
.ds-lab { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.diag-types { display: flex; flex-direction: column; gap: 12rpx; }
.diag-type-row { display: flex; align-items: center; }
.dt-name { width: 120rpx; font-size: 24rpx; color: #666; }
.dt-bar-bg { flex: 1; height: 16rpx; background: #f0f2f5; border-radius: 8rpx; overflow: hidden; margin: 0 12rpx; }
.dt-bar { height: 100%; background: #7CB9E8; border-radius: 8rpx; }
.dt-pct { width: 72rpx; text-align: right; font-size: 24rpx; color: #666; }
.diag-warns { margin-top: 18rpx; }
.diag-warn { font-size: 24rpx; color: #ff9800; line-height: 1.7; }

.est-tag-nav { color: #999; border-color: #ddd; background: #f5f5f5; }

/* ===== 横向滚动多列表(养基宝式:首列粘性 + 大字/高行/两行单元格) =====
   列顺序: 名称(1) 关联板块(2) 持有收益(3) 当日涨幅(4) 持有金额(5) 近1月(6) 近1年(7)
   列宽合计 = 260+160+180+140+170+120+120 = 1150rpx (须与 .tbl 一致,否则表头/数据错位) */
.tbl-scroll { width: 100%; background: #fff; }
.tbl { width: 1150rpx; }
.trow {
  display: flex; align-items: stretch;
  border-bottom: 1rpx solid #eef0f3; background: #fff;
}
.trow:active { background: #f8f9fa; }
.thead { background: #fff; }
.c {
  width: 150rpx; flex: none; box-sizing: border-box;
  padding: 26rpx 12rpx; white-space: nowrap;
  display: flex; flex-direction: column; align-items: flex-end; justify-content: center;
}
.thead .c { color: #999; font-size: 24rpx; font-weight: 400; padding: 20rpx 12rpx; }
/* 逐列宽度用显式 class(不用 nth-child:微信会把 WXML 注释算进 nth-child 导致错位) */
.c-bd   { width: 160rpx; }  /* 关联板块 */
.c-earn { width: 180rpx; }  /* 持有收益 */
.c-day  { width: 140rpx; }  /* 当日涨幅 */
.c-amt  { width: 170rpx; }  /* 持有金额 */
.c-m    { width: 120rpx; }  /* 近1月/近1年 */

/* 首列名称:粘性固定 + 左对齐 */
.c-name {
  width: 260rpx; flex: none; box-sizing: border-box;
  position: sticky; left: 0; z-index: 2; background: #fff;
  flex-direction: column; align-items: flex-start; justify-content: center;
  padding: 26rpx 12rpx 26rpx 24rpx;
}
.thead .c-name { background: #fff; }
.c-name .fund-name {
  font-size: 30rpx; font-weight: 600; color: #333; line-height: 1.3;
  max-width: 224rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.fund-sub { font-size: 22rpx; color: #bbb; margin-top: 8rpx; }

/* 单元格:大数字(上) + 小标签(下) */
.cell-top { font-size: 30rpx; font-weight: 600; line-height: 1.25; }
.cell-sub { font-size: 22rpx; margin-top: 8rpx; color: #999; }
.cell-top.dark { color: #333; }
.cell-top.muted, .cell-sub.muted { color: #bbb; font-weight: 400; }
.slide-hint { font-size: 20rpx; color: #bbb; text-align: center; padding: 14rpx 0; }
/* 估值来源角标(缩小,内联在涨幅后) */
.est-tag { font-size: 16rpx; color: #ff9800; border: 1rpx solid #ffcc80; background: #fff8ec; padding: 0 4rpx; border-radius: 4rpx; margin-left: 6rpx; }
