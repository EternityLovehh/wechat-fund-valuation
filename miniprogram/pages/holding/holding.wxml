<!--holding.wxml - 持仓页面-->
<wxs module="utils">
var toFixed = function(value, digits) {
  var num = parseFloat(value);
  if (isNaN(num)) {
    return '0.00';
  }
  return num.toFixed(digits || 2);
}

module.exports = {
  toFixed: toFixed
}
</wxs>

<scroll-view 
  scroll-y 
  class="container" 
  refresher-enabled 
  refresher-triggered="{{refreshing}}" 
  bindrefresherrefresh="onRefresh"
>
  <view class="summary">
    <view class="summary-title">持仓总金额（按已确认净值）</view>
    <view class="summary-value">¥{{utils.toFixed(totalValue, 2)}}</view>
    <view class="summary-profit-row">
      <view class="summary-profit {{totalDayProfit >= 0 ? 'positive' : 'negative'}}">
        今日估算 {{totalDayProfit >= 0 ? '+' : ''}}{{utils.toFixed(totalDayProfitRate, 2)}}%
      </view>
      <view class="summary-profit {{totalDayProfit >= 0 ? 'positive' : 'negative'}}">
        {{totalDayProfit >= 0 ? '+' : ''}}¥{{utils.toFixed(totalDayProfit, 2)}}
      </view>
    </view>
    <view wx:if="{{holdings.length > 0}}" class="data-source-bar">
      <text class="ds-status ds-{{marketStatus}}">{{statusLabel || '--'}}</text>
      <text wx:if="{{valuationTime}}" class="ds-item">估值 {{valuationTime}}</text>
      <text wx:if="{{valuationDate}}" class="ds-item">净值 {{valuationDate}}</text>
      <text class="ds-hint">· 估值仅为预测，盘后净值确认；带「自算」为重仓估算</text>
    </view>
    <view class="summary-actions">
      <button class="import-btn" bindtap="goToImport">导入持仓</button>
      <button class="calendar-btn" bindtap="goToCalendar">收益日历</button>
      <button class="clear-btn" bindtap="clearAllHoldings" wx:if="{{holdings.length > 0}}">清空</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
      <view class="sk-line sk-w60"></view>
      <view class="sk-line sk-w30"></view>
    </view>
  </view>

  <view wx:elif="{{holdings.length === 0}}" class="empty">
    <text>暂无持仓</text>
    <text class="empty-tip">在基金详情页添加持仓</text>
  </view>

  <view wx:else class="fund-list">
    <!-- 横向滚动多列表(养基宝式:大数字+小标签,首列粘性) -->
    <scroll-view scroll-x class="tbl-scroll">
      <view class="tbl">
        <view class="trow thead">
          <view class="c c-name">名称/占比</view>
          <view class="c c-bd">关联板块</view>
          <view class="c c-earn">持有收益</view>
          <view class="c c-day">当日涨幅</view>
          <view class="c c-amt">持有金额</view>
          <view class="c c-m">近1月</view>
          <view class="c c-m">近1年</view>
        </view>
        <view wx:for="{{holdings}}" wx:key="code" class="trow" bindtap="goToDetail" data-code="{{item.code}}">
          <view class="c c-name">
            <text class="fund-name">{{item.name}}</text>
            <view class="fund-sub">
              <text wx:if="{{item.pendingAmount > 0 && !item.shares}}" class="pending-tag">待确认</text>
              <text wx:elif="{{item.pendingAmount > 0}}" class="pending-tag">加仓中</text>
              <text wx:else>占比 {{utils.toFixed(item.holdingRatio, 2)}}%</text>
            </view>
          </view>
          <view class="c c-bd">
            <text class="cell-top {{item.boardChange == null ? 'muted' : (item.boardChange >= 0 ? 'positive' : 'negative')}}">{{item.boardChange == null ? '--' : (item.boardChange >= 0 ? '+' : '') + utils.toFixed(item.boardChange, 2) + '%'}}</text>
            <text class="cell-sub">{{item.board || '-'}}</text>
          </view>
          <view class="c c-earn">
            <block wx:if="{{item.pendingAmount > 0 && !item.shares}}"><text class="cell-top muted">确认中</text></block>
            <block wx:else>
              <text class="cell-top {{item.profit >= 0 ? 'positive' : 'negative'}}">{{item.profit >= 0 ? '+' : ''}}{{utils.toFixed(item.profit, 2)}}</text>
              <text class="cell-sub {{item.profitRate >= 0 ? 'positive' : 'negative'}}">{{item.profitRate >= 0 ? '+' : ''}}{{utils.toFixed(item.profitRate, 2)}}%</text>
            </block>
          </view>
          <view class="c c-day">
            <block wx:if="{{item.pendingAmount > 0 && !item.shares}}"><text class="cell-top muted">--</text></block>
            <block wx:else>
              <text class="cell-top {{item.dayGrowth >= 0 ? 'positive' : 'negative'}}">{{item.dayGrowth !== 0 ? (item.dayGrowth >= 0 ? '+' : '') + utils.toFixed(item.dayGrowth, 2) + '%' : '-'}}<text class="est-tag" wx:if="{{item.estimateSource === 'computed'}}">估</text></text>
              <text class="cell-sub {{item.todayProfit >= 0 ? 'positive' : 'negative'}}">{{item.todayProfit >= 0 ? '+' : ''}}{{utils.toFixed(item.todayProfit, 2)}}</text>
            </block>
          </view>
          <view class="c c-amt"><text class="cell-top dark">¥{{utils.toFixed(item.currentAmount || item.amount, 0)}}</text></view>
          <view class="c c-m"><text class="cell-top {{item.m1 >= 0 ? 'positive' : 'negative'}}">{{item.m1 >= 0 ? '+' : ''}}{{utils.toFixed(item.m1, 2)}}%</text></view>
          <view class="c c-m"><text class="cell-top {{item.y1 >= 0 ? 'positive' : 'negative'}}">{{item.y1 >= 0 ? '+' : ''}}{{utils.toFixed(item.y1, 2)}}%</text></view>
        </view>
      </view>
    </scroll-view>
    <view class="slide-hint">← 左右滑动查看更多 · 金额/收益按确认净值</view>
  </view>
</scroll-view>
