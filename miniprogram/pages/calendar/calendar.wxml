<!--calendar.wxml - 收益日历/月度统计-->
<wxs module="u">
var fmt = function(v) {
  var n = parseFloat(v);
  if (isNaN(n)) return '0.00';
  return (n >= 0 ? '+' : '') + n.toFixed(2);
}
var fmt2 = function(v) {
  var n = parseFloat(v);
  if (isNaN(n)) return '0.00';
  return n.toFixed(2);
}
module.exports = { fmt: fmt, fmt2: fmt2 }
</wxs>

<view class="container">
  <!-- 总资产走势 -->
  <view class="trend-card">
    <view class="trend-head">
      <text class="trend-title">总资产走势</text>
      <text wx:if="{{hasTrend}}" class="trend-latest">¥{{u.fmt2(trendLatest)}}</text>
    </view>
    <canvas wx:if="{{hasTrend}}" type="2d" id="trendChart" class="trend-canvas"></canvas>
    <view wx:if="{{hasTrend}}" class="trend-range">{{trendFrom}} ~ {{trendTo}}</view>
    <view wx:else class="trend-empty">数据积累中，多打开几天后显示走势</view>
  </view>

  <!-- 月度汇总 -->
  <view class="month-summary">
    <view class="ms-nav" bindtap="prevMonth">‹</view>
    <view class="ms-center">
      <view class="ms-label">{{monthLabel}}</view>
      <view class="ms-profit {{monthProfit >= 0 ? 'positive' : 'negative'}}">
        本月估算收益 {{u.fmt(monthProfit)}}
      </view>
      <view class="ms-days">盈 {{monthWinDays}} 天 · 亏 {{monthLoseDays}} 天</view>
    </view>
    <view class="ms-nav {{canGoNext ? '' : 'disabled'}}" bindtap="nextMonth">›</view>
  </view>

  <!-- 星期表头 -->
  <view class="week-heads">
    <view wx:for="{{weekHeads}}" wx:key="*this" class="wh">{{item}}</view>
  </view>

  <!-- 日历格子 -->
  <view class="grid">
    <view
      wx:for="{{cells}}"
      wx:key="index"
      class="cell {{item.day === 0 ? 'blank' : ''}} {{item.isToday ? 'today' : ''}}"
    >
      <block wx:if="{{item.day !== 0}}">
        <view class="cell-day">{{item.day}}</view>
        <view wx:if="{{item.hasData}}" class="cell-profit {{item.profit >= 0 ? 'positive' : 'negative'}}">
          {{u.fmt(item.profit)}}
        </view>
        <view wx:else class="cell-empty">-</view>
      </block>
    </view>
  </view>

  <view class="tip">数据自快照上线后按天累积，此前日期无记录。金额与当日收益均按盘后确认净值计算(非盘中估算)。</view>

  <!-- 估值准确度 -->
  <view wx:if="{{hasAcc}}" class="acc-card">
    <view class="acc-head">
      <text class="acc-title">估值准确度</text>
      <text class="acc-avg">近{{accCount}}次 平均偏差 {{u.fmt2(accAvgErr)}}%</text>
    </view>
    <view class="acc-list">
      <view class="acc-row acc-head-row">
        <text class="ac-code">代码</text>
        <text class="ac-cell">日期</text>
        <text class="ac-cell">估算</text>
        <text class="ac-cell">实际</text>
        <text class="ac-cell">偏差</text>
      </view>
      <view wx:for="{{accRecords}}" wx:key="index" class="acc-row">
        <text class="ac-code">{{item.code}}</text>
        <text class="ac-cell">{{item.date}}</text>
        <text class="ac-cell">{{u.fmt(item.est)}}%</text>
        <text class="ac-cell">{{u.fmt(item.actual)}}%</text>
        <text class="ac-cell">{{u.fmt2(item.est - item.actual)}}</text>
      </view>
    </view>
  </view>
</view>
