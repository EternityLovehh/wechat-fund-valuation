<!--index.wxml - 自选基金页面-->
<wxs module="utils">
var toFixed = function(value, digits) {
  var num = parseFloat(value);
  if (isNaN(num)) {
    return '0.00';
  }
  return num.toFixed(digits || 2);
}

module.exports = {
  toFixed: toFixed
}
</wxs>

<scroll-view 
  scroll-y 
  class="container" 
  refresher-enabled 
  refresher-triggered="{{refreshing}}" 
  bindrefresherrefresh="onRefresh"
>
  <view class="header">
    <view class="title">我的自选</view>
    <view class="header-actions">
      <view class="clear-btn" bindtap="clearAllFunds" wx:if="{{funds.length > 0}}">清空</view>
      <view class="add-btn" bindtap="goToSearch">+ 添加</view>
    </view>
  </view>

  <!-- 大盘指数 -->
  <view wx:if="{{marketIndex}}" class="market-index">
    <view wx:if="{{marketIndex.sh}}" class="index-item">
      <view class="index-name">{{marketIndex.sh.name}}</view>
      <view class="index-value">{{marketIndex.sh.current}}</view>
      <view class="index-change {{marketIndex.sh.changePercent >= 0 ? 'positive' : 'negative'}}">
        {{marketIndex.sh.changePercent >= 0 ? '+' : ''}}{{utils.toFixed(marketIndex.sh.changePercent, 2)}}%
      </view>
    </view>
    <view wx:if="{{marketIndex.sz}}" class="index-item">
      <view class="index-name">{{marketIndex.sz.name}}</view>
      <view class="index-value">{{marketIndex.sz.current}}</view>
      <view class="index-change {{marketIndex.sz.changePercent >= 0 ? 'positive' : 'negative'}}">
        {{marketIndex.sz.changePercent >= 0 ? '+' : ''}}{{utils.toFixed(marketIndex.sz.changePercent, 2)}}%
      </view>
    </view>
    <view wx:if="{{marketIndex.cyb}}" class="index-item">
      <view class="index-name">{{marketIndex.cyb.name}}</view>
      <view class="index-value">{{marketIndex.cyb.current}}</view>
      <view class="index-change {{marketIndex.cyb.changePercent >= 0 ? 'positive' : 'negative'}}">
        {{marketIndex.cyb.changePercent >= 0 ? '+' : ''}}{{utils.toFixed(marketIndex.cyb.changePercent, 2)}}%
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
      <view class="sk-line sk-w60"></view>
      <view class="sk-line sk-w30"></view>
    </view>
  </view>

  <view wx:elif="{{funds.length === 0}}" class="empty">
    <text>暂无自选基金</text>
    <button class="add-first-btn" bindtap="goToSearch">添加自选</button>
  </view>

  <view wx:else class="fund-list">
    <view class="list-header">
      <view class="header-name">名称/代码</view>
      <view class="header-value">估值<text class="header-hint">(预测)</text></view>
      <view class="header-today">今日盈亏</view>
      <view class="header-year">持仓/1年</view>
    </view>

    <scroll-view scroll-y class="list-body">
      <view wx:for="{{funds}}" wx:key="code" class="list-item" bindtap="goToDetail" data-code="{{item.code}}">
        <view class="item-name">
          <view class="fund-name">{{item.name}}</view>
          <view class="fund-code">
            <text>{{item.code}}</text>
            <text class="holding-tag" wx:if="{{item.holdingAmount > 0}}">持仓</text>
          </view>
        </view>

        <view class="item-value">
          <view class="current-price">
            {{utils.toFixed(item.estimatedValue, 4)}}
            <text class="est-tag" wx:if="{{item.estimateSource === 'computed'}}">自算</text>
            <text class="est-tag est-tag-nav" wx:elif="{{item.estimateSource === 'none'}}">净值</text>
          </view>
          <view class="holding-amount" wx:if="{{item.holdingAmount > 0}}">
            ¥{{utils.toFixed(item.holdingAmount, 0)}}
          </view>
        </view>

        <view class="item-today {{item.estimatedGrowth >= 0 ? 'positive' : 'negative'}}">
          <view class="change-percent">{{item.estimatedGrowth >= 0 ? '+' : ''}}{{utils.toFixed(item.estimatedGrowth, 2)}}%</view>
          <view class="profit-value" wx:if="{{item.holdingAmount > 0}}">
            {{item.todayProfit >= 0 ? '+' : ''}}{{utils.toFixed(item.todayProfit, 2)}}
          </view>
        </view>

        <view class="item-year">
          <block wx:if="{{item.holdingAmount > 0}}">
            <view class="holding-profit {{item.holdingProfit >= 0 ? 'positive' : 'negative'}}">
              {{item.holdingProfit >= 0 ? '+' : ''}}{{utils.toFixed(item.holdingProfit, 2)}}
            </view>
            <view class="holding-rate {{item.holdingProfit >= 0 ? 'positive' : 'negative'}}" wx:if="{{item.holdingAmount > 0}}">
              {{item.holdingProfit >= 0 ? '+' : ''}}{{utils.toFixed((item.holdingProfit / (item.holdingAmount - item.holdingProfit)) * 100, 2)}}%
            </view>
          </block>
          <block wx:else>
            <text class="{{item.yearGrowth >= 0 ? 'positive' : 'negative'}}" wx:if="{{item.yearGrowth !== undefined && item.yearGrowth !== 0}}">{{item.yearGrowth >= 0 ? '+' : ''}}{{utils.toFixed(item.yearGrowth, 2)}}%</text>
            <text class="year-empty" wx:else>-</text>
          </block>
        </view>
      </view>

      <view class="data-source-bar">
        <text class="ds-status ds-{{marketStatus}}">{{statusLabel || '--'}}</text>
        <text wx:if="{{valuationTime}}" class="ds-item">估值 {{valuationTime}}</text>
        <text wx:if="{{valuationDate}}" class="ds-item">净值 {{valuationDate}}</text>
        <text class="ds-hint">估值仅为预测，盘后基金公司确认净值后更新；带「自算」为前十大重仓估算，非官方值</text>
      </view>
    </scroll-view>
  </view>
</scroll-view>
