<!--index.wxml - 自选基金页面-->
<wxs module="utils">
var toFixed = function(value, digits) {
  var num = parseFloat(value);
  if (isNaN(num)) {
    return '0.00';
  }
  return num.toFixed(digits || 2);
}

module.exports = {
  toFixed: toFixed
}
</wxs>

<scroll-view 
  scroll-y 
  class="container" 
  refresher-enabled 
  refresher-triggered="{{refreshing}}" 
  bindrefresherrefresh="onRefresh"
>
  <view class="header">
    <view class="title">我的自选</view>
    <view class="header-actions">
      <view class="clear-btn" bindtap="clearAllFunds" wx:if="{{funds.length > 0}}">清空</view>
      <view class="add-btn" bindtap="goToSearch">+ 添加</view>
    </view>
  </view>

  <!-- 大盘指数(网格) -->
  <view wx:if="{{marketIndices.length > 0}}" class="market-index">
    <view wx:for="{{marketIndices}}" wx:key="name" class="index-item">
      <view class="index-name">{{item.name}}</view>
      <view class="index-value">{{utils.toFixed(item.current, 2)}}</view>
      <view class="index-change {{item.changePercent >= 0 ? 'positive' : 'negative'}}">
        {{item.changePercent >= 0 ? '+' : ''}}{{utils.toFixed(item.changePercent, 2)}}%
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
      <view class="sk-line sk-w60"></view>
      <view class="sk-line sk-w30"></view>
    </view>
  </view>

  <view wx:elif="{{funds.length === 0}}" class="empty">
    <text>暂无自选基金</text>
    <button class="add-first-btn" bindtap="goToSearch">添加自选</button>
  </view>

  <view wx:else class="fund-list">
    <!-- 横向滚动多列表：首列(名称)粘性固定，右侧列可左右滑动 -->
    <scroll-view scroll-x class="tbl-scroll">
      <view class="tbl">
        <view class="trow thead">
          <view class="c c-name">名称/代码</view>
          <view class="c c-est">估值</view>
          <view class="c c-day">今日</view>
          <view class="c c-bd">关联板块</view>
          <view class="c c-m">近1月</view>
          <view class="c c-m">近1年</view>
          <view class="c c-amt">持有金额</view>
        </view>
        <view wx:for="{{funds}}" wx:key="code" class="trow" bindtap="goToDetail" data-code="{{item.code}}">
          <view class="c c-name">
            <text class="fund-name">{{item.name}}</text>
            <view class="fund-sub"><text>{{item.code}}</text><text class="holding-tag" wx:if="{{item.holdingAmount > 0}}">持仓</text></view>
          </view>
          <view class="c c-est">
            <text class="cell-top dark">{{utils.toFixed(item.estimatedValue, 4)}}</text>
            <text class="cell-sub" wx:if="{{item.estimateSource === 'computed'}}">自算</text>
            <text class="cell-sub" wx:elif="{{item.estimateSource === 'none'}}">净值</text>
          </view>
          <view class="c c-day">
            <text class="cell-top {{item.estimatedGrowth >= 0 ? 'positive' : 'negative'}}">{{item.estimatedGrowth >= 0 ? '+' : ''}}{{utils.toFixed(item.estimatedGrowth, 2)}}%</text>
            <text class="cell-sub {{item.todayProfit >= 0 ? 'positive' : 'negative'}}" wx:if="{{item.holdingAmount > 0}}">{{item.todayProfit >= 0 ? '+' : ''}}{{utils.toFixed(item.todayProfit, 2)}}</text>
          </view>
          <view class="c c-bd">
            <text class="cell-top {{item.boardChange == null ? 'muted' : (item.boardChange >= 0 ? 'positive' : 'negative')}}">{{item.boardChange == null ? '--' : (item.boardChange >= 0 ? '+' : '') + utils.toFixed(item.boardChange, 2) + '%'}}</text>
            <text class="cell-sub">{{item.board || '-'}}</text>
          </view>
          <view class="c c-m"><text class="cell-top {{item.m1 >= 0 ? 'positive' : 'negative'}}">{{item.m1 >= 0 ? '+' : ''}}{{utils.toFixed(item.m1, 2)}}%</text></view>
          <view class="c c-m"><text class="cell-top {{item.y1 >= 0 ? 'positive' : 'negative'}}">{{item.y1 >= 0 ? '+' : ''}}{{utils.toFixed(item.y1, 2)}}%</text></view>
          <view class="c c-amt"><text class="cell-top dark">{{item.holdingAmount > 0 ? '¥' + utils.toFixed(item.holdingAmount, 0) : '-'}}</text></view>
        </view>
      </view>
    </scroll-view>

    <view class="data-source-bar">
      <text class="ds-status ds-{{marketStatus}}">{{statusLabel || '--'}}</text>
      <text wx:if="{{valuationTime}}" class="ds-item">估值 {{valuationTime}}</text>
      <text wx:if="{{valuationDate}}" class="ds-item">净值 {{valuationDate}}</text>
      <text class="ds-hint">← 左右滑动查看更多 · 估值为预测，带「自算」为重仓估算</text>
    </view>
  </view>
</scroll-view>
