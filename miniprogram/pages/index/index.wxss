/**index.wxss - 自选基金页面**/
page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding: 0 !important;
  justify-content: flex-start !important;
  align-items: stretch !important;
}

.header {
  background: #7CB9E8;
  color: white;
  padding: 25rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: none;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.add-btn, .clear-btn {
  background: rgba(255, 255, 255, 0.3);
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.clear-btn {
  background: rgba(255, 68, 68, 0.3);
}

/* 大盘指数 */
.market-index {
  background: white;
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.index-item {
  width: 33.333%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 0;
}

.index-name {
  font-size: 22rpx;
  color: #999;
}

.index-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.index-change {
  font-size: 22rpx;
  font-weight: 600;
}

.loading, .empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
  background: white;
}

.add-first-btn {
  margin-top: 40rpx;
  background: #7CB9E8;
  color: white;
}

/* 列表容器 */
.fund-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: white;
  overflow: hidden;
  min-height: 0;
}

.list-header {
  display: flex;
  height: 70rpx;
  align-items: center;
  background: #f8f8f8;
  padding: 0 24rpx;
  flex-shrink: 0;
  gap: 12rpx;
}

.header-name {
  flex: 4;
  font-size: 24rpx;
  color: #999;
}

.header-value {
  flex: 2;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.header-today {
  flex: 2;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.header-year {
  flex: 2;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.list-body {
  flex: 1;
  min-height: 0;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
  gap: 12rpx;
}

.list-item:active {
  background: #f8f8f8;
}

.item-name {
  flex: 4;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.fund-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-code {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.holding-tag {
  font-size: 18rpx;
  background: #e3f2fd;
  color: #2196f3;
  padding: 0 8rpx;
  border-radius: 4rpx;
  line-height: 1.4;
}

.item-value {
  flex: 2;
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 自算估值角标：区分"前十大重仓自算"的近似值与官方估值 */
.est-tag {
  font-size: 16rpx;
  color: #ff9800;
  border: 1rpx solid #ffcc80;
  background: #fff8ec;
  padding: 0 4rpx;
  border-radius: 4rpx;
  margin-left: 6rpx;
  line-height: 1.3;
  vertical-align: middle;
}

.current-price {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.holding-amount {
  font-size: 20rpx;
  color: #999;
  font-weight: normal;
}

.item-today {
  flex: 2;
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.change-percent {
  font-size: 26rpx;
  font-weight: 700;
}

.profit-value {
  font-size: 20rpx;
  font-weight: normal;
}

.item-year {
  flex: 2;
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.holding-profit {
  font-size: 26rpx;
  font-weight: 600;
}

.holding-rate {
  font-size: 20rpx;
  font-weight: normal;
}

.year-empty {
  color: #ccc;
  font-size: 26rpx;
}

.positive {
  color: #f56c6c;
}

.negative {
  color: #67c23a;
}

.update-time {
  text-align: center;
  padding: 30rpx 20rpx;
  color: #999;
  font-size: 22rpx;
  background: white;
  border-top: none;
}

.header-hint {
  font-size: 20rpx;
  color: #bbb;
  margin-left: 4rpx;
  font-weight: normal;
}

.data-source-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 12rpx;
  padding: 24rpx 20rpx 30rpx;
  background: white;
  font-size: 22rpx;
  color: #999;
}

.ds-status {
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  color: #666;
  font-weight: 500;
}
.ds-status.ds-trading {
  background: #ffeae0;
  color: #ff5722;
}
.ds-status.ds-lunch,
.ds-status.ds-pre-open,
.ds-status.ds-post-close {
  background: #eef4ff;
  color: #4a8cff;
}
.ds-status.ds-weekend {
  background: #f0f0f0;
  color: #999;
}

.ds-item {
  color: #888;
}
.ds-hint {
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.est-tag-nav { color: #999; border-color: #ddd; background: #f5f5f5; }

/* ===== 横向滚动多列表(养基宝式:首列粘性 + 大字/高行/两行单元格) =====
   列顺序: 名称(1) 估值(2) 今日(3) 关联板块(4) 近1月(5) 近1年(6) 持有金额(7)
   列宽合计 = 260+150+140+160+120+120+160 = 1110rpx (须与 .tbl 一致,否则表头/数据错位) */
.tbl-scroll { width: 100%; background: #fff; }
.tbl { width: 1110rpx; }
.trow {
  display: flex; align-items: stretch;
  border-bottom: 1rpx solid #eef0f3; background: #fff;
}
.trow:active { background: #f8f9fa; }
.thead { background: #fff; }
/* 数据单元格:统一列(flex-direction:column) + 右对齐,表头与数据用完全相同的宽度规则 */
.c {
  width: 150rpx; flex: none; box-sizing: border-box;
  padding: 26rpx 12rpx; white-space: nowrap;
  display: flex; flex-direction: column; align-items: flex-end; justify-content: center;
}
.thead .c { color: #999; font-size: 24rpx; font-weight: 400; padding: 20rpx 12rpx; }
/* 逐列宽度用显式 class(不用 nth-child:微信会把 WXML 注释算进 nth-child 导致错位) */
.c-est { width: 150rpx; }  /* 估值 */
.c-day { width: 140rpx; }  /* 今日 */
.c-bd  { width: 160rpx; }  /* 关联板块 */
.c-m   { width: 120rpx; }  /* 近1月/近1年 */
.c-amt { width: 160rpx; }  /* 持有金额 */

/* 首列名称:粘性固定 + 左对齐 */
.c-name {
  width: 260rpx; flex: none; box-sizing: border-box;
  position: sticky; left: 0; z-index: 2; background: #fff;
  flex-direction: column; align-items: flex-start; justify-content: center;
  padding: 26rpx 12rpx 26rpx 24rpx;
}
.thead .c-name { background: #fff; }
.c-name .fund-name {
  font-size: 27rpx; font-weight: 500; color: #444; line-height: 1.3;
  max-width: 224rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.fund-sub { font-size: 21rpx; color: #bbb; margin-top: 6rpx; display: flex; align-items: center; gap: 10rpx; }

/* 单元格:数字(上) + 小标签(下) */
.cell-top { font-size: 28rpx; font-weight: 500; line-height: 1.25; }
.cell-sub { font-size: 21rpx; margin-top: 6rpx; color: #999; }
.cell-top.dark { color: #444; }
.cell-top.muted { color: #bbb; font-weight: 400; }
.holding-tag { font-size: 18rpx; color: #2196f3; background: #e3f2fd; padding: 0 8rpx; border-radius: 4rpx; }
