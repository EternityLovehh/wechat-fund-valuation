/**search.wxss - 搜索基金页面**/
page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  padding: 0 !important;
  justify-content: flex-start !important;
  align-items: stretch !important;
}

/* 搜索头部 */
.search-header {
  background: linear-gradient(135deg, #7CB9E8 0%, #6BA8D8 100%);
  padding: 25rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(124, 185, 232, 0.2);
  flex-shrink: 0;
}

.search-box {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 40rpx;
  padding: 0 30rpx;
  height: 80rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.search-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
  color: #7CB9E8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-icon {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f5f5f5;
  transition: all 0.2s;
}

.clear-icon:active {
  background: #e0e0e0;
  transform: scale(0.9);
}

/* 加载中 */
.loading {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 搜索结果列表 */
.result-list {
  flex: 1;
  padding: 20rpx 30rpx;
  background: #f5f5f5;
}

.fund-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.2s;
}

.fund-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.fund-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.fund-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.fund-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.fund-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-type-badge {
  font-size: 20rpx;
  color: #7CB9E8;
  background: linear-gradient(135deg, #e8f4ff 0%, #f0f8ff 100%);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.fund-code {
  font-size: 24rpx;
  color: #999;
}

.fund-right {
  text-align: right;
  flex-shrink: 0;
}

.fund-value-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.net-value {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.estimated-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.growth-row {
  display: flex;
  justify-content: flex-end;
}

.growth {
  font-size: 26rpx;
  font-weight: 600;
}

.growth.positive {
  color: #f56c6c;
}

.growth.negative {
  color: #67c23a;
}

/* 添加按钮 */
.fund-action {
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: flex-end;
}

.add-btn {
  background: linear-gradient(135deg, #7CB9E8 0%, #6BA8D8 100%);
  color: white;
  padding: 18rpx 48rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(124, 185, 232, 0.35);
  transition: all 0.2s;
}

.add-btn::after {
  border: none;
}

.add-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(124, 185, 232, 0.25);
}

.add-btn.added {
  background: linear-gradient(135deg, #f0f0f0 0%, #e5e5e5 100%);
  color: #999;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 空状态 */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  background: white;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.25;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

/* 提示区域 */
.tips-container {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  background: #f5f5f5;
}

.tips-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding-left: 10rpx;
}

/* 热门搜索 */
.hot-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.keyword-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.keyword-item {
  background: linear-gradient(135deg, #e8f4ff 0%, #f0f8ff 100%);
  color: #7CB9E8;
  border: 2rpx solid #7CB9E8;
  padding: 18rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(124, 185, 232, 0.15);
}

.keyword-item:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, #7CB9E8 0%, #6BA8D8 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(124, 185, 232, 0.3);
}
