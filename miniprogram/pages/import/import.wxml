<!--import.wxml - 导入持仓页面-->
<view class="container">
  <view class="header">
    <view class="title">导入持仓</view>
    <view class="help-btn" bindtap="showAlipayGuide">使用帮助</view>
  </view>

  <view class="tabs">
    <view 
      class="tab {{activeTab === 'batch' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="batch"
    >
      手动输入
    </view>
    <view 
      class="tab {{activeTab === 'ocr' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="ocr"
    >
      拍照识别
    </view>
  </view>

  <!-- 手动输入 -->
  <view wx:if="{{activeTab === 'batch'}}" class="batch-import">
    <view class="tips">
      <text class="tips-title">📋 快速导入</text>
      <text class="tips-text">输入基金基本信息，系统将自动锚定份额</text>
    </view>

    <view class="manual-input-form">
      <view class="input-group">
        <view class="input-label">基金代码或名称</view>
        <input 
          class="form-input" 
          placeholder="例如：110022 或 易方达消费" 
          value="{{inputCodeOrName}}" 
          bindinput="onCodeInput"
        />
      </view>
      
      <view class="input-row">
        <view class="input-group flex-1">
          <view class="input-label">持有金额 (元)</view>
          <input 
            class="form-input" 
            type="digit"
            placeholder="当前总市值" 
            value="{{inputAmount}}" 
            bindinput="onAmountInput"
          />
        </view>
        <view class="input-group flex-1 margin-left">
          <view class="input-label">持有收益 (元)</view>
          <input 
            class="form-input" 
            type="text"
            placeholder="累计盈亏" 
            value="{{inputProfit}}" 
            bindinput="onProfitInput"
          />
        </view>
      </view>

      <button class="add-to-list-btn" bindtap="addToList">添加到待导入列表</button>
    </view>


    <view wx:if="{{importList.length > 0}}" class="preview">
      <view class="preview-header">
        <text class="preview-title">识别结果 ({{importList.length}})</text>
      </view>

      <scroll-view scroll-y class="preview-list">
        <view wx:for="{{importList}}" wx:key="code" class="preview-item">
          <view class="item-info">
            <view class="item-code">{{item.code}}</view>
            <view class="item-detail">
              份额: {{item.shares}} | 成本: ¥{{item.cost.toFixed(4)}}
            </view>
          </view>
          <view class="item-action" bindtap="removeItem" data-index="{{index}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
      </scroll-view>

      <button 
        class="import-btn" 
        bindtap="doImport" 
        loading="{{importing}}"
        disabled="{{importing}}"
      >
        {{importing ? '导入中...' : '确认导入'}}
      </button>
    </view>
  </view>

  <!-- 拍照识别 -->
  <view wx:if="{{activeTab === 'ocr'}}" class="ocr-import">
    <view class="tips">
      <text class="tips-title">📸 拍照识别</text>
      <text class="tips-text">使用百度AI OCR识别基金信息</text>
      <text class="tips-text" style="margin-top: 10rpx; color: #4caf50;">✅ 50,000次免费额度，识别准确率高</text>
    </view>

    <view class="upload-area">
      <button class="upload-btn album" bindtap="chooseImage">
        <text class="icon">📸</text>
        <text class="text">选择图片</text>
      </button>
    </view>

    <view wx:if="{{ocrImages.length > 0}}" class="image-preview">
      <view class="images-grid">
        <view wx:for="{{ocrImages}}" wx:key="index" class="image-item">
          <image src="{{item}}" mode="aspectFill" class="preview-image-small" />
          <view class="remove-icon" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
      </view>
      <view class="image-count">已选择 {{ocrImages.length}} 张图片</view>
      <button class="reselect-btn" bindtap="reselectImage">重新选择</button>
      <button 
        class="ocr-btn" 
        bindtap="recognizeImage" 
        loading="{{recognizing}}"
        disabled="{{recognizing}}"
      >
        {{recognizing ? '识别中...' : '开始识别'}}
      </button>
    </view>

    <view wx:if="{{ocrResult}}" class="ocr-result">
      <view class="result-header">
        <text class="result-title">识别结果</text>
        <text class="result-action" bindtap="clearOcrResult">清空</text>
      </view>
      <textarea 
        class="result-textarea" 
        value="{{ocrResult}}"
        bindinput="onOcrResultInput"
        maxlength="-1"
      />
      <button class="parse-btn" bindtap="parseOcrResult">解析数据</button>
    </view>

    <view wx:if="{{importList.length > 0}}" class="preview">
      <view class="preview-header">
        <text class="preview-title">识别结果 ({{importList.length}})</text>
      </view>

      <scroll-view scroll-y class="preview-list">
        <view wx:for="{{importList}}" wx:key="code" class="preview-item">
          <view class="item-info">
            <view class="item-code">{{item.code}}</view>
            <view class="item-detail">
              份额: {{item.shares}} | 成本: ¥{{item.cost.toFixed(4)}}
            </view>
          </view>
          <view class="item-action" bindtap="removeItem" data-index="{{index}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
      </scroll-view>

      <button 
        class="import-btn" 
        bindtap="doImport" 
        loading="{{importing}}"
        disabled="{{importing}}"
      >
        {{importing ? '导入中...' : '确认导入'}}
      </button>
    </view>

    <!-- OCR使用指南 -->
    <view class="guide">
      <view class="guide-title">💡 如何使用OCR？</view>
      <view class="guide-steps">
        <view class="step">
          <text class="step-num">1</text>
          <text class="step-text">配置百度AI OCR（首次使用，5分钟）</text>
        </view>
        <view class="step">
          <text class="step-num">2</text>
          <text class="step-text">选择持仓截图（每次1-2张）</text>
        </view>
        <view class="step">
          <text class="step-num">3</text>
          <text class="step-text">点击"开始识别"，等待识别完成</text>
        </view>
        <view class="step">
          <text class="step-num">4</text>
          <text class="step-text">检查并编辑识别结果</text>
        </view>
        <view class="step">
          <text class="step-num">5</text>
          <text class="step-text">点击"解析数据"，确认导入</text>
        </view>
      </view>

      <view class="guide-tips">
        <text class="tips-item">📌 使用百度AI OCR服务</text>
        <text class="tips-item">📌 50,000次免费额度（一次性）</text>
        <text class="tips-item">📌 识别准确率高，速度快</text>
        <text class="tips-item">📌 需要配置API Key（5分钟）</text>
        <text class="tips-item">📌 识别后建议手动检查数据准确性</text>
      </view>
    </view>
  </view>
</view>
