/* mine.wxss */
.container {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 0 0 40rpx;
  box-sizing: border-box;
}

.mine-header {
  background: #7CB9E8;
  color: #fff;
  padding: 56rpx 32rpx 48rpx;
  display: flex;
  align-items: center;
}
.avatar {
  position: relative;
  flex: none;
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-img { width: 100%; height: 100%; display: block; }
.avatar-emoji { font-size: 56rpx; line-height: 1; }
/* 透明按钮覆盖整个圆做点击热区(chooseAvatar 必须用 button) */
.avatar-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  opacity: 0;
}
.avatar-hit::after { border: none; }
.p-info { display: flex; flex-direction: column; }
.p-name { font-size: 38rpx; font-weight: 600; }
.p-sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }

.group {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.group-title {
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 24rpx 8rpx;
}
.cell {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-top: 1rpx solid #f2f3f5;
}
.cell:first-of-type { border-top: none; }
.cell-hover { background: #f5f7fa; }
.cell-icon { font-size: 36rpx; margin-right: 20rpx; }
.cell-main { flex: 1; display: flex; flex-direction: column; }
.cell-label { font-size: 30rpx; color: #333; }
.cell-desc { font-size: 22rpx; color: #aaa; margin-top: 4rpx; }
.cell-arrow { font-size: 40rpx; color: #ccc; margin-left: 12rpx; }

.mine-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  margin-top: 40rpx;
  padding: 0 32rpx;
}
.mf-app { font-size: 22rpx; color: #aaa; }
.mf-sub { font-size: 20rpx; color: #ccc; text-align: center; line-height: 1.5; }

/* 破除 app.wxss 全局 .container(flex居中/200rpx留白)泄漏 */
.container { display: block; }
