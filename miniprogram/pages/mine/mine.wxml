<!--mine.wxml - 我的（聚合入口）-->
<view class="container">
  <view class="mine-header">
    <view class="avatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" />
      <text wx:else class="avatar-emoji">📈</text>
      <button class="avatar-hit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>
    <view class="p-info" bindtap="editName">
      <text class="p-name">{{nickname}}</text>
      <text class="p-sub">点头像换图 · 点名字改昵称 ✎</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title">分析</view>
    <view class="cell" bindtap="goCalendar" hover-class="cell-hover">
      <text class="cell-icon">📊</text>
      <view class="cell-main"><text class="cell-label">统计分析</text><text class="cell-desc">走势 · 收益日历 · 估值准确度</text></view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goPenetration" hover-class="cell-hover">
      <text class="cell-icon">🔍</text>
      <view class="cell-main"><text class="cell-label">持仓穿透</text><text class="cell-desc">重仓/板块合并暴露 · 持仓诊断</text></view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title">工具</view>
    <view class="cell" bindtap="goCompare" hover-class="cell-hover">
      <text class="cell-icon">⚖️</text>
      <view class="cell-main"><text class="cell-label">基金对比</text></view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goRank" hover-class="cell-hover">
      <text class="cell-icon">🏆</text>
      <view class="cell-main"><text class="cell-label">基金排行</text></view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goCalc" hover-class="cell-hover">
      <text class="cell-icon">🧮</text>
      <view class="cell-main"><text class="cell-label">定投计算器</text></view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goNews" hover-class="cell-hover">
      <text class="cell-icon">📰</text>
      <view class="cell-main"><text class="cell-label">市场要闻</text></view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title">设置</view>
    <view class="cell" bindtap="goAlert" hover-class="cell-hover">
      <text class="cell-icon">🔔</text>
      <view class="cell-main"><text class="cell-label">涨跌提醒</text><text class="cell-desc">{{alertOn ? '已开启 · 全部持仓 ±阈值提醒' : '对所有持仓设置涨跌提醒'}}</text></view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="group-title">数据</view>
    <view class="cell" bindtap="clearData" hover-class="cell-hover">
      <text class="cell-icon">🗑️</text>
      <view class="cell-main"><text class="cell-label">清空统计数据</text><text class="cell-desc">走势 / 日历 / 准确度（不影响自选持仓）</text></view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="mine-footer">
    <text class="mf-app">基金估值助手 v{{version}}</text>
    <text class="mf-sub">数据来源：东方财富 / 腾讯财经，仅供参考，不构成投资建议</text>
  </view>
</view>
