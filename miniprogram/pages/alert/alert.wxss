/* pages/alert/alert.wxss */
.container { display: block; min-height: 100vh; background: #f5f6f8; padding: 24rpx; box-sizing: border-box; }

.card { background: #fff; border-radius: 16rpx; padding: 8rpx 28rpx; margin-bottom: 24rpx; }

.row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; }
.row-main { padding: 28rpx 0; }
.row-l { display: flex; flex-direction: column; }
.row-title { font-size: 30rpx; color: #333; font-weight: 500; }
.row-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; max-width: 460rpx; }
.row-val { font-size: 30rpx; font-weight: 600; display: flex; align-items: center; }
.row-arrow { color: #ccc; font-size: 34rpx; margin-left: 10rpx; }
.divider { height: 1rpx; background: #f0f0f0; }

.positive { color: #ff4444; }
.negative { color: #2ba471; }

.renew-badge { font-size: 24rpx; color: #fff; background: #ff6b6b; border-radius: 24rpx; padding: 8rpx 24rpx; }
.renew-badge.ok { background: #e8f7f0; color: #2ba471; }

.tips { padding: 8rpx 12rpx; }
.tips-title { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.tips-item { font-size: 22rpx; color: #aaa; line-height: 1.7; }
